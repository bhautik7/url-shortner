# Environment Configuration for URL Shortener
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/url_shortener
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_CONNECT_TIMEOUT=1.0

# Counter Batching Configuration (Write Service)
# Central Redis counter key
COUNTER_KEY=url_shortener:global_counter
# Initial counter start offset (Base62 "100000" equivalent if starting fresh)
COUNTER_START_OFFSET=1000000
# Batch size leased by each write service instance
COUNTER_BATCH_SIZE=1000

# Cache Configuration (Read Service)
CACHE_KEY_PREFIX=url:
CACHE_DEFAULT_TTL_SECONDS=86400
CACHE_MAX_TTL_SECONDS=604800

# Rate Limiting Configuration (Write Service)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Base URL used for constructing response short URLs
BASE_URL=http://localhost

# Service Ports
WRITE_SERVICE_PORT=8001
READ_SERVICE_PORT=8002
